---
import { getCollection, render } from "astro:content";
import { Separator } from "./separator.tsx";
import { components, H1BottomSpacing } from "./mdx-components.tsx";

const updates = (await getCollection("update")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<div class="flex flex-col gap-2 overflow-scroll">
  {
    updates.map(async (update, idx) => {
      const { Content } = await render(update);
      const isLast = idx === updates.length - 1;

      return (
        <div>
          <Content components={{ ...components, h1: H1BottomSpacing }} />

          {!isLast && <Separator />}
        </div>
      );
    })
  }
</div>
