---
import { Font } from "astro:assets";
import { Card, CardTitle } from "../components/card";
import SideLinkItem from "../components/side-link-item.tsx";
import LayoutNavigation from "../components/compositions/layout-navigation.tsx";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  publishedAt?: string;
  updatedAt?: string;
  googleSiteVerification?: string;
}

const { title, description, publishedAt, updatedAt, googleSiteVerification } =
  Astro.props;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: publishedAt,
  dateModified: updatedAt,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }

    <Font cssVariable="--font-fira-code" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title ?? "Ketela's Blog"}</title>

    {title && <meta name="og:title" content={title} />}
    {description && <meta name="description" content={description} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLD)}
    />
  </head>

  <body
    class="bg-dark-bg text-dark-text-primary px-8 py-8 font-mono md:px-32 lg:px-72"
  >
    <div class="grid grid-cols-3 gap-4">
      <main class="col-span-3 flex flex-col gap-8">
        <slot />
      </main>
    </div>
  </body>
</html>
