---
import { Font } from "astro:assets";
import { Card, CardTitle } from "../components/card";
import SideLinkItem from "../components/side-link-item.tsx";
import LayoutNavigation from "../components/compositions/layout-navigation.tsx";
import { Image } from "astro:assets";
import nekowebButton3 from "../assets/buttons/nekoweb/button3.gif";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  publishedAt?: string;
  updatedAt?: string;
  googleSiteVerification?: string;
}

const { title, description, publishedAt, updatedAt, googleSiteVerification } =
  Astro.props;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: publishedAt,
  dateModified: updatedAt,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }

    <Font cssVariable="--font-fira-code" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title ?? "Ketela's Blog"}</title>

    {title && <meta name="og:title" content={title} />}
    {description && <meta name="description" content={description} />}

    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLD)}
    />
  </head>

  <body
    class="bg-dark-bg text-dark-text-primary px-8 py-8 font-mono md:px-32 lg:px-72"
  >
    <header class="mb-8 grid grid-cols-12 gap-4">
      <Card className="col-span-12">
        <CardTitle>
          <h1>Navigation</h1>
        </CardTitle>

        <LayoutNavigation client:load />
      </Card>
      <!-- <Card className="col-span-2" /> -->
    </header>

    <div class="grid grid-cols-3 gap-4">
      <aside class="col-span-3 mb-8 flex flex-col gap-8 lg:col-span-1 lg:mb-0">
        <Card>
          <CardTitle>
            <h1>About Me</h1>
          </CardTitle>

          <div class="flex flex-col gap-2">
            <pre
              aria-hidden="true"
              class="text-dark-text-primary inline-block text-left text-[.5rem] leading-none whitespace-pre">
██╗  ██╗███████╗████████╗███████╗██╗      █████╗
██║ ██╔╝██╔════╝╚══██╔══╝██╔════╝██║     ██╔══██╗
█████╔╝ █████╗     ██║   █████╗  ██║     ███████║
██╔═██╗ ██╔══╝     ██║   ██╔══╝  ██║     ██╔══██║
██║  ██╗███████╗   ██║   ███████╗███████╗██║  ██║
╚═╝  ╚═╝╚══════╝   ╚═╝   ╚══════╝╚══════╝╚═╝  ╚═╝
            </pre>

            <p>
              Hi! My name is{" "}
              <span class="text-dark-text-primary underline">Ketela</span>,
              welcome to my blog. You can read my random yappers here. Enjoy :D
            </p>
          </div>
        </Card>

        <Card>
          <CardTitle>
            <h1>Links</h1>
          </CardTitle>

          <nav aria-label="Sidebar Links">
            <ul class="list-inside list-disc">
              <SideLinkItem
                href="https://nekoweb.org/follow/ketela"
                target="_blank">Follow me on Nekoweb</SideLinkItem
              >
            </ul>
          </nav>
        </Card>
      </aside>

      <div class="col-span-3 flex flex-col gap-8 lg:col-span-2">
        <main class="flex flex-col gap-8">
          <slot />
        </main>

        <footer>
          <Card className="flex-row justify-center">
            <div class="flex flex-col items-center gap-2">
              <a
                target="_blank"
                title="Powered By Nekoweb"
                href="https://nekoweb.org/"
              >
                <Image
                  src={nekowebButton3}
                  width={88}
                  height={31}
                  alt="Nekoweb Button"
                />
              </a>
              <!-- button by exund -->

              <span
                >Powered By <a
                  href="https://nekoweb.org/"
                  title="nekoweb.org"
                  class="text-dark-accent-amber underline hover:cursor-pointer"
                  >Nekoweb</a
                ></span
              >
            </div>
          </Card>
        </footer>
      </div>
    </div>
  </body>
</html>
