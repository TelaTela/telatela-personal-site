---
import { getCollection } from "astro:content";
import { Card, CardTitle } from "../../components/card.tsx";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog");
---

<Layout title="Blog Entries">
  <Card>
    <CardTitle>Blog Entries</CardTitle>

    <ul class="list-inside list-disc">
      {
        posts.map((post) => (
          <li>
            <a
              class="hover:text-dark-text-primary focus:text-dark-text-primary active:text-dark-text-primary hover:underline focus:underline active:underline"
              href={`/blog/${post.id}`}
            >
              {post.data.title} ({post.data.publishedAt.toLocaleDateString()})
            </a>
          </li>
        ))
      }
    </ul>
  </Card>
</Layout>
