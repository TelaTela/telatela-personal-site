---
import { getCollection } from "astro:content";
import { Card, CardTitle } from "../../components/card.tsx";
import { Separator } from "../../components/separator.tsx";
import BlogsList from "../../components/blogs-list.tsx";
import BlogTagsList from "../../components/blog-tags-list.tsx";
import Layout from "../../layouts/Layout.astro";
import { latest } from "../../lib/collections/blog.ts";

const posts = await latest();
---

<Layout title="Blog Entries">
  <Card>
    <CardTitle>
      <h1>Blog Entries</h1>
    </CardTitle>

    <BlogsList posts={posts} />
  </Card>

  <BlogTagsList />
</Layout>
