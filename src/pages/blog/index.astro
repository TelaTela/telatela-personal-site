---
import { getCollection } from "astro:content";
import { Card, CardTitle } from "../../components/card.tsx";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog");
---

<Layout title="Blog Entries">
  <Card>
    <CardTitle>Blog Entries</CardTitle>

    <ul class="list-disc">
      {
        posts.map((post) => (
          <li key={post.id}>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </Card>
</Layout>
