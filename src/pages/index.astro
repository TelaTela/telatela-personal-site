---
import { Card, CardTitle } from "../components/card.tsx";
import RecentBlogs from "../components/recent-blogs.tsx";
import SiteUpdates from "../components/site-updates.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout googleSiteVerification="yJl7fexRtv4qiAN_1FOchs0SZ-XAyx0dt0nsyw4KuiU">
  <Card>
    <CardTitle>
      <h1>Work In Progress 👷‍♂️</h1>
    </CardTitle>

    <p class="text-dark-text-primary text-xl font-bold">
      THIS SITE IS STILL UNDER CONSTRUCTION!!!
    </p>
  </Card>

  <div class="flex flex-col gap-8 lg:max-h-96 lg:flex-row lg:gap-4">
    <Card className="max-h-96 lg:max-h-full lg:basis-1/2">
      <CardTitle>
        <h1>Recent Blogs</h1>
      </CardTitle>

      <RecentBlogs />
    </Card>

    <Card className="max-h-96 lg:max-h-full lg:basis-1/2">
      <CardTitle>
        <h1>Site Updates</h1>
      </CardTitle>

      <SiteUpdates />
    </Card>
  </div>
</Layout>
